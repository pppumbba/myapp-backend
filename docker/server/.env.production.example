# The API's settings on the server. Copy to .env.production next to this file (it is git-ignored)
# and fill in the blanks. Take the secrets from Render's Environment page: APP_KEY must stay the
# same as on Render, or anything encrypted with it can no longer be read.
# api.example.com below stands for the server's address: your domain, or <ip-with-dashes>.sslip.io.

APP_NAME="Wand Studio"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
# The frontend that may call the API (CORS).
FRONTEND_URL=https://myapp-frontend.chinzorigganbat555.workers.dev

# To the container's output, so `docker compose logs app` shows errors.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The database is the mysql service in docker-compose.yml: its DB_* settings there win over any
# here, and its passwords are in .env next to this file (move-db.sh makes them).
DB_CONNECTION=mysql

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Emails are only logged until a mail service is set up.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Google sign-in: add https://api.example.com/auth/google/callback to the OAuth client's redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_ALLOW_SIGNUP=

# Tender market: payments through QPay. No DAN driver is connected yet.
MARKET_PAYMENT_DRIVER=qpay
QPAY_URL=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
