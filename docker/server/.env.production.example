# Copy to .env.production on the server and fill in the blanks (the same values as on Render).
APP_NAME="Wand Studio"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://
FRONTEND_URL=https://myapp-frontend.chinzorigganbat555.workers.dev
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=defaultdb
# Users and logins live here; customers have their own schemas (see customers:adopt).
DB_MAIN_DATABASE=wand_studio
DB_USERNAME=avnadmin
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
